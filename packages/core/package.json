{
  "name": "@comma-agents/core",
  "version": "2.0.0-rc.1",
  "description": "Core agent orchestration framework: agents, flows, hooks, and providers",
  "license": "MIT",
  "author": "CloAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/CloAI/CommaAgents.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hub": {
      "types": "./dist/hub/index.d.ts",
      "import": "./dist/hub/index.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "import": "./dist/sandbox/index.js"
    },
    "./strategy": {
      "types": "./dist/strategy/index.d.ts",
      "import": "./dist/strategy/index.js"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "import": "./dist/skills/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./language": {
      "types": "./dist/language/index.d.ts",
      "import": "./dist/language/index.js"
    },
    "./hub/comma-project.schema.json": "./dist/hub/comma-project.schema.json",
    "./conversation-context": {
      "types": "./dist/conversation-context/index.d.ts",
      "import": "./dist/conversation-context/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "bun run ../../scripts/build-public-package.ts core",
    "prepack": "bun run build",
    "test": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src"
  },
  "dependencies": {
    "@ai-sdk/mcp": "1.0.52",
    "@ai-sdk/openai": "3.0.39",
    "@ai-sdk/openai-compatible": "2.0.30",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@phala/dcap-qvl": "0.7.0",
    "@types/diff": "8.0.0",
    "ai": "6.0.91",
    "diff": "9.0.0",
    "jose": "6.2.13",
    "liquidjs": "10.27.0",
    "strip-json-comments": "5.0.3",
    "tar-stream": "3.2.0",
    "turndown": "7.2.4",
    "yaml": "2.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@comma-agents/utils": "file:../utils",
    "@types/tar-stream": "^3.1.4",
    "@types/turndown": "5.0.6",
    "zod-to-json-schema": "3.25.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
