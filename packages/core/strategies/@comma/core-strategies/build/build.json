{
  "name": "Build",
  "version": "3.0",
  "description": "Implement code changes, verify them with the project's checks and an independent verifier, and hand back to you after each turn.",
  "agents": {
    "user": {
      "type": "user",
      "description": "Your next request or reply.",
      "config": { "requireInput": true }
    },
    "builder": {
      "description": "Implements and verifies code changes.",
      "model": "@medium",
      "maxSteps": 150,
      "systemPromptTemplate": { "template": "./prompts/builder.md" },
      "context": {
        "instructions": true,
        "environment": true,
        "compaction": {
          "keepRecentTokens": 20000,
          "model": "@compaction",
          "extraSections": ["Verification status"]
        }
      },
      "subagents": {
        "explore": "../subagents/explore/explore.json",
        "verify": "../subagents/verify/verify.json"
      },
      "tools": [
        "read_file",
        "glob",
        "grep",
        "lsp_request",
        "create_file",
        "write_file",
        "edit_file",
        "delete_file",
        "move_file",
        "restore_file",
        "run_command",
        "load_skill",
        "ask_questions",
        "delegate",
        "todo_add",
        "todo_complete",
        "todo_get",
        "todo_get_next",
        "todo_remove"
      ]
    }
  },
  "flow": {
    "name": "Build Loop",
    "type": "cycle",
    "description": "You send a request; the builder works until it reports back; repeat.",
    "cycles": "Infinity",
    "steps": [{ "agent": "user" }, { "agent": "builder" }]
  }
}
