{
  "name": "Research",
  "version": "1.0",
  "description": "Web research on a question: splits it into sub-questions, runs parallel workers, and returns a sourced answer that flags uncertainty.",
  "modelRoles": {
    "primary": "openrouter/google/gemini-3.5-flash",
    "subagent": "openrouter/google/gemini-3.5-flash",
    "fast": "openrouter/google/gemma-4-26b-a4b-it"
  },
  "agents": {
    "lead": {
      "model": "@subagent",
      "maxSteps": 20,
      "systemPrompt": "./prompts/lead.md",
      "context": { "environment": true },
      "subagents": {
        "research-worker": "../research-worker/research-worker.json"
      },
      "tools": ["delegate"]
    }
  },
  "flow": {
    "name": "Research",
    "type": "sequential",
    "steps": [{ "agent": "lead" }]
  }
}
