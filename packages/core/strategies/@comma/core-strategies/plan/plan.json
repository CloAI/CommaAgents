{
  "name": "Plan",
  "version": "3.0",
  "description": "Explore the codebase, settle open decisions with you, and produce a decision-complete plan to hand to Build.",
  "modelRoles": {
    "primary": "openrouter/google/gemini-3.5-flash",
    "subagent": "openrouter/google/gemini-3.5-flash",
    "fast": "openrouter/google/gemma-4-26b-a4b-it"
  },
  "agents": {
    "user": {
      "type": "user",
      "description": "Your goal, answers, and feedback on the plan.",
      "config": { "requireInput": true }
    },
    "planner": {
      "description": "Investigates read-only and writes the plan.",
      "model": "@primary",
      "maxSteps": 80,
      "systemPromptTemplate": { "template": "./prompts/planner.md" },
      "context": {
        "instructions": true,
        "environment": true,
        "compaction": {
          "keepRecentTokens": 20000,
          "model": "@compaction",
          "extraSections": ["Plan status"]
        }
      },
      "subagents": {
        "explore": "../subagents/explore/explore.json",
        "plan-critic": "../subagents/plan-critic/plan-critic.json"
      },
      "tools": [
        "read_file",
        "list_directory",
        "search_files",
        "glob",
        "lsp_request",
        "load_skill",
        "ask_question",
        "delegate",
        "request_strategy_switch"
      ]
    }
  },
  "flow": {
    "name": "Plan Loop",
    "type": "cycle",
    "description": "You describe the goal or answer questions; the planner investigates and replies; repeat.",
    "cycles": "Infinity",
    "steps": [{ "agent": "user" }, { "agent": "planner" }]
  }
}
