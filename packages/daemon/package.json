{
  "name": "@comma-agents/daemon",
  "version": "2.0.0-rc.1",
  "description": "Agent daemon that executes flows and exposes a WebSocket API",
  "license": "MIT",
  "author": "CloAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/CloAI/CommaAgents.git",
    "directory": "packages/daemon"
  },
  "bin": {
    "comma-agents-daemon": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/daemon-server/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "start": "node --import tsx src/cli.ts start --foreground",
    "build": "node --import tsx ../../scripts/build-public-package.ts daemon",
    "prepack": "pnpm run build",
    "test": "vitest run packages/daemon/src --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.30",
    "@comma-agents/core": "2.0.0-rc.1",
    "@logtape/file": "2.3.7",
    "@logtape/logtape": "2.3.7",
    "typescript": "6.0.2",
    "yaml": "2.8.3",
    "yargs": "17.7.2",
    "zod": "3.25.76",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.70.0"
  },
  "devDependencies": {
    "@comma-agents/utils": "file:../utils",
    "@types/yargs": "17.0.33",
    "ai": "6.0.91"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
