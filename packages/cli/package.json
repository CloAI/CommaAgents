{
  "name": "@comma-agents/cli",
  "version": "2.0.0-rc.1",
  "description": "Unified command-line installer and launcher for CommaAgents",
  "license": "MIT",
  "author": "CloAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/CloAI/CommaAgents.git",
    "directory": "packages/cli"
  },
  "bin": {
    "comma": "dist/comma.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "node --import tsx scripts/build-package.ts",
    "build:standalone": "node --import tsx scripts/build-standalone.ts",
    "link:global": "pnpm run build && pnpm link --global",
    "unlink:global": "pnpm unlink --global",
    "prepack": "pnpm run build",
    "test": "vitest run packages/cli/src --coverage",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src"
  },
  "devDependencies": {
    "@comma-agents/utils": "file:../utils",
    "@types/react": "19.3.0",
    "@types/yargs": "17.0.33",
    "ink-select-input": "6.2.0",
    "ink-testing-library": "4.0.0",
    "react-devtools-core": "8.0.0",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@comma-agents/core": "2.0.0-rc.1",
    "@comma-agents/daemon": "2.0.0-rc.1",
    "@comma-agents/tui": "2.0.0-rc.1",
    "ink": "8.0.0",
    "react": "19.3.1",
    "yargs": "17.7.2"
  }
}
