{
  "name": "@comma-agents/tui",
  "version": "2.0.0-rc.1",
  "description": "Terminal UI for CommaAgents that connects to the daemon via WebSocket",
  "license": "MIT",
  "author": "CloAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/CloAI/CommaAgents.git",
    "directory": "packages/tui"
  },
  "bin": {
    "comma-agents-tui": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "start": "node --import tsx src/main.tsx",
    "build": "node --import tsx ../../scripts/build-public-package.ts tui",
    "prepack": "pnpm run build",
    "generate:frames": "node --import tsx src/components/TitleIcon/icon-generator/generator.ts",
    "test": "vitest run packages/tui/src --coverage",
    "test:e2e": "COMMA_TUI_E2E=1 vitest run ../../examples/e2e/tui --maxWorkers=1 --no-file-parallelism",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "docs": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build"
  },
  "dependencies": {
    "@amandaghassaei/stl-parser": "1.7.0",
    "@comma-agents/core": "2.0.0-rc.1",
    "@comma-agents/daemon": "2.0.0-rc.1",
    "@shikijs/cli": "^4.5.0",
    "chalk": "6.0.1",
    "cli-table3": "0.6.5",
    "gl-matrix": "3.4.4",
    "ink": "8.0.0",
    "ink-select-input": "6.2.0",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-devtools-core": "8.0.0",
    "react-router": "^8.5.0",
    "shiki": "4.5.0",
    "string-width": "8.3.0",
    "word-wrap": "1.2.5",
    "yargs": "18.2.0",
    "yoga-layout": "3.2.1",
    "react-reconciler": "0.34.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/yargs": "17.0.35",
    "ink-testing-library": "4.0.0",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
