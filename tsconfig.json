{
  "compilerOptions": {
    "paths": {
      "@comma-agents/core": ["./packages/core/src/index.ts"],
      "@comma-agents/core/hub": ["./packages/core/src/hub/index.ts"],
      "@comma-agents/core/sandbox": ["./packages/core/src/sandbox/index.ts"],
      "@comma-agents/daemon": ["./packages/daemon/src/index.ts"],
      "@comma-agents/tui": ["./packages/tui/src/index.ts"],
      "@comma-agents/utils": ["./packages/utils/src/index.ts"]
    },
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun-types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "outDir": "dist"
  },
  "exclude": ["node_modules", "dist"]
}
