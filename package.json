{
  "name": "comma-agents",
  "version": "2.0.0-rc.1",
  "private": true,
  "description": "Composable agent orchestration framework",
  "license": "MIT",
  "author": "CloAI",
  "type": "module",
  "scripts": {
    "build": "pnpm run packages:build && pnpm run packages:validate",
    "test": "vitest run",
    "test:e2e": "vitest run examples/e2e/",
    "lint": "oxlint packages examples",
    "lint:fix": "oxlint --fix packages examples; pnpm run format && pnpm run lint",
    "format": "oxfmt \"packages/**/*.ts\" \"packages/**/*.tsx\" \"examples/**/*.ts\" \"examples/**/*.tsx\"",
    "format:check": "oxfmt --check \"packages/**/*.ts\" \"packages/**/*.tsx\" \"examples/**/*.ts\" \"examples/**/*.tsx\"",
    "knip": "knip",
    "cli": "node --import tsx packages/cli/src/main.ts",
    "cli:build": "pnpm --dir packages/cli build",
    "cli:build:standalone": "pnpm --dir packages/cli build:standalone",
    "cli:link": "pnpm --dir packages/cli link:global",
    "cli:unlink": "pnpm --dir packages/cli unlink:global",
    "packages:build": "pnpm --dir packages/core build && pnpm --dir packages/daemon build && pnpm --dir packages/tui build && pnpm --dir packages/cli build",
    "packages:validate": "node --import tsx scripts/validate-public-packages.ts",
    "release:version": "node --import tsx scripts/release-version.ts sync",
    "release:check-tag": "node --import tsx scripts/release-version.ts check-tag",
    "hooks:install": "git config core.hooksPath .githooks",
    "version": "pnpm run release:version && pnpm run build",
    "daemon": "pnpm --filter @comma-agents/daemon start",
    "tui": "pnpm --dir packages/tui start",
    "example": "node --import tsx examples/core/strategies/run.ts",
    "example:tui": "pnpm --dir examples tui",
    "docs": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "tui:docs": "pnpm --dir packages/tui/docs dev",
    "tui:docs:build": "pnpm --dir packages/tui/docs build",
    "tui:e2e": "COMMA_TUI_E2E=1 vitest run examples/e2e/tui --maxWorkers=1 --no-file-parallelism",
    "tui:storybook": "pnpm --dir packages/tui-storybook storybook",
    "tui:storybook:build": "pnpm --dir packages/tui-storybook build",
    "ui": "pnpm --dir packages/core build && pnpm --dir packages/daemon build && pnpm --dir packages/ui dev",
    "ui:build": "pnpm --dir packages/core build && pnpm --dir packages/daemon build && pnpm --dir packages/ui build",
    "ui:storybook": "pnpm --dir packages/core build && pnpm --dir packages/daemon build && pnpm --dir packages/ui storybook",
    "ui:storybook:build": "pnpm --dir packages/core build && pnpm --dir packages/daemon build && pnpm --dir packages/ui storybook:build",
    "desktop": "pnpm --dir packages/desktop dev",
    "desktop:build": "pnpm --dir packages/desktop package"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@vitest/coverage-v8": "3.2.7",
    "knip": "6.0.5",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "rolldown": "1.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@10.30.0"
}
