+import Yoga from 'yoga-layout';
+import createReconciler from 'react-reconciler';
+import { LegacyRoot } from 'react-reconciler/constants.js';
+import { createHostConfig } from './reconciler.js';
+import { createNode } from './dom.js';
+// Lazy-initialised secondary reconciler dedicated to measureLayout. Kept
+// in module scope so we pay the setup cost once per process, not once per
+// measureLayout call. `isPrimaryRenderer: false` keeps it from competing
+// with the main `render()` pipeline for React's primary-renderer slot,
+// and the host config is created fresh so its internal priority state is
+// isolated from the primary reconciler.
+let measurementReconciler;
+const getMeasurementReconciler = () => {
+    if (measurementReconciler === undefined) {
+        measurementReconciler = createReconciler(createHostConfig({ isPrimaryRenderer: false }));
+    }
+    return measurementReconciler;
+};
+/**
+Measure the layout dimensions of a React element synchronously, without writing
+to any terminal stream or starting a persistent Ink instance.
+
+Builds a detached Yoga tree mirroring the JSX, computes layout at the given
+constraints, reads the resulting box dimensions, and tears the tree down. The
+yoga nodes are freed before this function returns so there are no listener,
+state, or memory leaks.
+
+The helper uses a dedicated secondary `react-reconciler` instance so it is
+safe to call from inside a live render — the primary reconciler's work
+queue is untouched. This is the property that makes it usable as the
+backing measurement primitive for virtualized lists like `ScrollableView`.
+
+**Notes:**
+
+- Terminal-specific hooks (`useInput`, `useStdin`, `useStdout`, `useStderr`,
+  `useApp`, `useFocus`, `useFocusManager`) return default no-op values, identical
+  to `renderToString`. They will not throw, but they will not function as in a
+  live terminal.
+- Context providers consumed by the JSX (themes, accessibility, app-level state)
+  must be wrapped around the node by the caller; the detached tree does not
+  inherit context from any live `<App>`.
+- JSX must render synchronously. Suspense / async rendering is not supported.
+- Each call constructs a reconciler container, runs effects, and tears the
+  tree down again. For hot paths (per-item row height in a virtual list)
+  callers should memoize results — e.g. keyed by `(itemKey, width)`.
+- If a component throws during rendering, the error is propagated to the
+  caller after cleanup.
+
+@example
+```ts
+import {measureLayout, Box, Text} from 'ink';
+
+const {width, height} = measureLayout(
+    <Box flexDirection="column">
+        <Text>line one</Text>
+        <Text>line two</Text>
+    </Box>,
+    {width: 40}
+);
+// width === 8, height === 2
+```
+*/
+const measureLayout = (node, options) => {
+    const widthConstraint = options.width;
+    const heightConstraint = options.height;
+    // Create a standalone root node — no stdout, stdin, or terminal bindings.
+    const rootNode = createNode('ink-root');
+    rootNode.onComputeLayout = () => {
+        rootNode.yogaNode.setWidth(widthConstraint);
+        if (heightConstraint !== undefined) {
+            rootNode.yogaNode.setHeight(heightConstraint);
+        }
+        rootNode.yogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+    };
+    // Capture the first uncaught error so we can re-throw it after cleanup.
+    let uncaughtError;
+    const reconciler = getMeasurementReconciler();
+    // Create a reconciler container in legacy (synchronous) mode.
+    // The four trailing callbacks are: onUncaughtError, onCaughtError,
+    // onRecoverableError, and onHostTransitionComplete.
+    // eslint-disable-next-line @typescript-eslint/no-unsafe-assignment
+    const container = reconciler.createContainer(rootNode, LegacyRoot, null, false, null, 'measure-layout', (error) => {
+        uncaughtError ??= error;
+    }, () => { }, () => { }, () => { }, null);
+    let teardownSucceeded = false;
+    try {
+        // Synchronously render the React tree into the container. Commit runs
+        // resetAfterCommit, which fires our onComputeLayout — yoga layout is
+        // ready by the time updateContainerSync returns.
+        reconciler.updateContainerSync(node, container, null, () => { });
+        reconciler.flushSyncWork();
+        const measured = {
+            width: rootNode.yogaNode.getComputedWidth(),
+            height: rootNode.yogaNode.getComputedHeight(),
+        };
+        // Tear down: unmount the tree so the reconciler cleans up child nodes
+        // and runs effect cleanup functions. Child Yoga nodes are freed by the
+        // reconciler's removeChildFromContainer → cleanupYogaNode → freeRecursive.
+        reconciler.updateContainerSync(null, container, null, () => { });
+        reconciler.flushSyncWork();
+        teardownSucceeded = true;
+        // Free the root yoga node itself (children already freed by reconciler).
+        rootNode.yogaNode.free();
+        // Re-throw after full cleanup so callers see the original error.
+        if (uncaughtError !== undefined) {
+            throw uncaughtError instanceof Error
+                ? uncaughtError
+                : // eslint-disable-next-line @typescript-eslint/no-base-to-string
+                    new Error(String(uncaughtError));
+        }
+        return measured;
+    }
+    finally {
+        // Ensure native Yoga memory is freed even if rendering or teardown threw.
+        // Yoga nodes are WASM-backed and not garbage collected.
+        if (!teardownSucceeded && rootNode.yogaNode) {
+            try {
+                // If reconciler teardown failed, some child nodes may not have
+                // been freed. Use freeRecursive to clean up the entire tree as
+                // a best-effort.
+                rootNode.yogaNode.freeRecursive();
+            }
+            catch {
+                // Best-effort: node may already be partially freed.
+            }
+        }
+    }
+};
+export default measureLayout;
